{
  "manifest_version": 3,
  "name": "ExtWatch Companion",
  "version": "0.1.0",
  "description": "Lets the ExtWatch desktop app disable an extension with one click and learn about installs and updates immediately. Does nothing on its own.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "management",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "minimum_chrome_version": "110"
}
