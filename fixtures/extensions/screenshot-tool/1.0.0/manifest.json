{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "ScreenTool",
  "description": "__MSG_appDesc__",
  "version": "1.0.0",
  "default_locale": "en",
  "key": "",
  "update_url": "https://clients2.google.com/service/update2/crx",
  "homepage_url": "https://screenshot-tool.example.com",
  "icons": {
    "16": "icon16.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_appName__"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.example.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "110"
}
